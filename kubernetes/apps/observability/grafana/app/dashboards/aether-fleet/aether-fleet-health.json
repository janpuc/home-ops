{
  "uid": "aether-fleet-health",
  "title": "Aether Fleet Health",
  "description": "Right-now fleet health: is everything up, and is the exporter itself even collecting? Read top row first \u2014 every other panel here (and on every other aether-* dashboard) is downstream of the exporter answering its scrape.",
  "tags": ["aether", "fleet"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporter Liveness (Prometheus scrape)",
      "description": "Prometheus's own verdict on whether it could scrape aether-fleet-exporter at all \u2014 upstream of every aether_* metric on every dashboard. Healthy = 1 (green, \"UP\"). Unhealthy = 0 (red, \"DOWN\") or no data at all (also styled red): if this is anything but a solid green 1, every other panel here is stale or empty and cannot be trusted, no matter what it shows.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "up{job=\"aether-fleet-exporter\"}",
          "legendFormat": "exporter scrape",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "DOWN (no data)",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "state-timeline",
      "title": "Per-Source Scrape Health",
      "description": "Each collector's own scrape_ok flag, one row per source \u2014 healthy is a solid green bar (value 1) for the whole window; any red segment (0) or gap (collector didn't report) means that specific collector failed or the exporter itself was down. Covers a2a, t3, harness (per-harness) and quota collectors \u2014 herdr and litellm have no scrape_ok of their own, see the up/down stats below for those instead.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "aether_a2a_scrape_ok",
          "legendFormat": "a2a ({{source}})",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "aether_t3_scrape_ok",
          "legendFormat": "t3 ({{source}})",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "aether_harness_scrape_ok",
          "legendFormat": "harness ({{harness}})",
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "aether_quota_scrape_ok",
          "legendFormat": "quota ({{plan}})",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILED",
                  "color": "red"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ok",
                  "color": "green"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "rowHeight": 0.8
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "hermes A2A gateway up",
      "description": "aether_a2a_up: 1 if the hermes A2A gateway answered its /metrics endpoint this scrape. This covers ONLY the A2A gateway \u2014 not T3, not herdr, not litellm. Healthy = green 1. Red 0 or no data = the gateway did not answer.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 11
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "aether_a2a_up{source=\"a2a\"}",
          "legendFormat": "a2a",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center"
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN"
                }
              }
            },
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "UP"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
