{
  "newVersionCheck": {
    "enabled": false
  },
  "oauth": {
    "enabled": true,
    "issuerUrl": "__OIDC_ISSUER__",
    "clientId": "__OIDC_CLIENT_ID__",
    "clientSecret": "__OIDC_CLIENT_SECRET__",
    "scope": "openid email profile",
    "buttonText": "Login with Pocket ID",
    "autoRegister": true,
    "autoLaunch": false,
    "storageLabelClaim": "preferred_username"
  },
  "server": {
    "externalDomain": "https://photos.janpuc.com"
  },
  "job": {
    "backgroundTask": { "concurrency": 1 },
    "faceDetection": { "concurrency": 1 },
    "library": { "concurrency": 2 },
    "metadataExtraction": { "concurrency": 2 },
    "migration": { "concurrency": 1 },
    "notifications": { "concurrency": 1 },
    "search": { "concurrency": 2 },
    "sidecar": { "concurrency": 1 },
    "smartSearch": { "concurrency": 1 },
    "thumbnailGeneration": { "concurrency": 1 }
  },
  "storageTemplate": {
    "enabled": true,
    "hashVerificationEnabled": true,
    "template": "{{y}}/{{y}}-{{MM}}-{{dd}}/{{filename}}"
  }
}
