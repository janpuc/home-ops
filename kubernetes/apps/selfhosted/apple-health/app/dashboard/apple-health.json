{
  "uid": "apple-health",
  "title": "Apple Health",
  "tags": ["health"],
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "",
  "schemaVersion": 39,
  "description": "Apple Health from the Health Auto Export app, through apple-health-ingester into VictoriaMetrics. Daily panels group by UTC day.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "victoriametrics-metrics-datasource",
        "regex": "/apple-health/",
        "current": {
          "text": "apple-health",
          "value": "apple-health"
        },
        "hide": 2
      },
      {
        "name": "target",
        "label": "Person",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-metrics-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values({__name__=\"step_count_count_qty\"}, target_name)",
          "refId": "target"
        },
        "definition": "label_values({__name__=\"step_count_count_qty\"}, target_name)",
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Steps, last 24 h",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(sum_over_time({__name__=\"step_count_count_qty\",target_name=~\"$target\"}[24h]))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Active energy, last 24 h",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(sum_over_time({__name__=\"active_energy_kJ_qty\",target_name=~\"$target\"}[24h])) / 4.184",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kcal",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Distance, last 24 h",
      "datasource": {
        "type": "victoriametrics-metrics-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "victoriametrics-metrics-datasource",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum(sum_over_time({__name__=\"walking_running_distance_km_qty\",target_name=~\"$target\"}[24h]))",
          "legendFormat": "",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "lengthkm",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value"
      }
    },
