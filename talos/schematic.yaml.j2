---
customization:
  extraKernelArgs:
    - amd_iommu=on # PCI Passthrough
    - iommu=pt # PCI Passthrough
    - amdgpu.gttsize=2048 # Cap iGPU GTT aperture at 2 GiB (was 8 GiB default).
  systemExtensions:
    officialExtensions:
      - siderolabs/amd-ucode # AMD iGPU
      - siderolabs/amdgpu # AMD iGPU
      - siderolabs/drbd # Miroir DRBD9 Replication
