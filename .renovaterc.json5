{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>home-operations/renovate-presets#11.0.0",
    "github>home-operations/renovate-presets//apps/llamacpp.json5#11.0.0",
    "github>home-operations/renovate-presets//apps/searxng.json5#11.0.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#11.0.0",
    ":timezone(Europe/Warsaw)",
  ],
  lockFileMaintenance: {
    enabled: true,
    schedule: ["before 3am on the first day of the month"],
    commitMessageExtra: "({{manager}})",
    additionalBranchPrefix: "{{manager}}-",
  },
  packageRules: [
    // Auto-merge rules
    {
      description: "Auto-merge trusted OCI digests",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge high-cadence OCI packages weekly",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/kube-prometheus-stack/"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
      schedule: ["before 6am on Monday"],
    },
    {
      description: "Auto-merge GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge trusted GitHub Actions",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\\//", "/^renovatebot\\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "1 minute",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Grafana dashboards",
      matchDatasources: ["custom.grafana-dashboards"],
      matchUpdateTypes: ["major"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    {
      description: "Auto-merge Renovate Presents",
      matchManagers: ["renovate-config"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "pr",
      ignoreTests: false,
    },
    // Routine container image updates merge themselves: Renovate merges once the
    // checks pass, with no kritika review, agent or broker. Only helmrelease.yaml
    // images, never charts (an ocirepository.yaml bump can carry CRDs), and never
    // the namespaces and paths pr-lane protects. Minor updates wait longer. Remove
    // the minor rule if minor updates cause trouble (Jan, 2026-11-03).
    {
      description: "Auto-merge routine image digest and patch updates",
      matchFileNames: [
        "kubernetes/apps/*/*/app/helmrelease.yaml",
        "!kubernetes/apps/{kube-system,flux-system,network,security,cnpg-system,miroir-system,kopiur-system,external-secrets,cert-manager}/**",
        "!kubernetes/apps/ai/litellm*/**",
      ],
      matchUpdateTypes: ["digest", "patch"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
      ignoreTests: false,
    },
    {
      description: "Auto-merge routine image minor updates",
      matchFileNames: [
        "kubernetes/apps/*/*/app/helmrelease.yaml",
        "!kubernetes/apps/{kube-system,flux-system,network,security,cnpg-system,miroir-system,kopiur-system,external-secrets,cert-manager}/**",
        "!kubernetes/apps/ai/litellm*/**",
      ],
      matchUpdateTypes: ["minor"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "7 days",
      ignoreTests: false,
    },
    {
      description: "Actions Runner Controller Group",
      groupName: "actions-runner-controller",
      matchDatasources: ["docker"],
      matchPackageNames: ["/gha-runner-scale-set-controller/", "/gha-runner-scale-set/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Flux Operator Group",
      groupName: "flux-operator",
      matchDatasources: ["docker"],
      matchPackageNames: ["/flux-operator/", "/flux-instance/"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "Kubernetes Group",
      groupName: "kubernetes",
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/",
      ],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 5,
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    // After the mise tools catch-all so talos wins its own group; unites the
    // mise pin, the factory installer image, and the tuppr upgrade version
    {
      description: "Talos Group",
      groupName: "talos",
      matchPackageNames: ["siderolabs/talos"],
      group: {
        commitMessageTopic: "{{{groupName}}} group",
      },
      minimumGroupSize: 2,
    },
    {
      description: "CoreDNS 1.14.3+ prefetch poisons autopath answers, hold until coredns/coredns#8390 is fixed",
      matchDatasources: ["docker"],
      matchPackageNames: ["ghcr.io/coredns/charts/coredns"],
      enabled: false,
    },
    {
      description: "1Password CLI is not resolvable on GitHub, bump manually",
      matchManagers: ["mise"],
      matchDepNames: ["1password-cli"],
      enabled: false,
    },
    // Labeling rules
    {
      matchUpdateTypes: ["major"],
      addLabels: ["type/major"],
    },
    {
      matchUpdateTypes: ["minor"],
      addLabels: ["type/minor"],
    },
    {
      matchUpdateTypes: ["patch"],
      addLabels: ["type/patch"],
    },
    {
      matchUpdateTypes: ["digest"],
      addLabels: ["type/digest"],
    },
  ],
}
