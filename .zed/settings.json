{
  "wrap_guides": [100],
  "show_wrap_guides": true,
  "sticky_scroll": {
    "enabled": false
  },
  "languages": {
    "JSON": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSON5": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "JSONC": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "Markdown": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "YAML": {
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    }
  },
  "lsp": {
    "yaml-language-server": {
      "settings": {
        "yaml": {
          "schemaStore": {
            "enable": true
          },
          "schemas": {
            "kubernetes": "./kubernetes/**/*.yaml"
          }
        }
      }
    }
  }
}
